[General]
loglevel = notify
# IP
ipv6 = false # 如无特殊需求不应开启 IPv6，目前网络环境下 IPv6 只会带来问题。
exclude-simple-hostnames = true # TRUE：在没有开启 TUN（增强模式）前提下，跳过简单主机名，如http://printer；http://nas；http://router
# DNS
read-etc-hosts = false #!MACOS-ONLY
hijack-dns = *:53
dns-server = 223.5.5.5, 223.6.6.6, 119.29.29.29, 119.28.28.28, 114.114.114.114, 8.8.8.8
# encrypted-dns-server = https://223.5.5.5/ # 除非当地 ISP 有严重的 DNS 污染问题，否则没必要开启 DoH，传统 DNS 的性能最优，网络异常后恢复速度最快
doh-server = https://doh.pub/dns-query
# UDP
block-quic = per-policy
udp-policy-not-supported-behaviour = REJECT
# TEST
internet-test-url = http://www.gstatic.com/generate_204
proxy-test-url = http://cp.cloudflare.com/generate_204
test-timeout = 5
# ACCESS
http-api-web-dashboard = false # 是其网页控制面板开关。开启后，可以通过浏览器访问其 HTTP API 页面，用网页方式查看和控制其。
http-api-tls = false # 让另一个App或者设备通过 HTTP API 控制其功能
# IOS
hide-vpn-icon = true #!REQUIREMENT "SYSTEM=='iOS' OR SYSTEM=='tvOS'"
wifi-assist = false #!IOS-ONLY # 当 Wi-Fi 信号差、网络不可用时，是否会自动使用蜂窝数据（4G/5G）辅助连接。
allow-wifi-access = false #!IOS-ONLY # 通过wifi用iOS做代理
# compatibility-mode = 5

[Ponte]
server-proxy-name= HK.SL
client-proxy-name= HK.SL
# ###############################################

[Proxy]
Tailnet = tailscale, section-name=TS
