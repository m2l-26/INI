[General]
loglevel = notify
# IP
ipv6 = false # 如无特殊需求不应开启 IPv6，目前网络环境下 IPv6 只会带来问题。
exclude-simple-hostnames = true # TRUE：在没有开启 TUN（增强模式）前提下，跳过简单主机名，如http://printer；http://nas；http://router
# DNS
read-etc-hosts = false #!MACOS-ONLY
hijack-dns = *:53
dns-server = 223.5.5.5, 223.6.6.6, 119.29.29.29, 119.28.28.28, 114.114.114.114, 8.8.8.8
# encrypted-dns-server = https://223.5.5.5/ # 除非当地 ISP 有严重的 DNS 污染问题，否则没必要开启 DoH，传统 DNS 的性能最优，网络异常后恢复速度最快
doh-server = https://doh.pub/dns-query
# UDP
block-quic = per-policy
udp-policy-not-supported-behaviour = REJECT
# TEST
internet-test-url = http://www.gstatic.com/generate_204
proxy-test-url = http://cp.cloudflare.com/generate_204
test-timeout = 5
# ACCESS
http-api-web-dashboard = false # 是其网页控制面板开关。开启后，可以通过浏览器访问其 HTTP API 页面，用网页方式查看和控制其。
http-api-tls = false # 让另一个App或者设备通过 HTTP API 控制其功能
# IOS
hide-vpn-icon = true #!REQUIREMENT "SYSTEM=='iOS' OR SYSTEM=='tvOS'"
wifi-assist = false #!IOS-ONLY # 当 Wi-Fi 信号差、网络不可用时，是否会自动使用蜂窝数据（4G/5G）辅助连接。
allow-wifi-access = false #!IOS-ONLY # 通过wifi用iOS做代理
# compatibility-mode = 5

[Ponte]
server-proxy-name= HK.SL
client-proxy-name= HK.SL
# ###############################################

[Proxy]
Tailnet = tailscale, section-name=TS

[Proxy Group]
ABD.SL = select, MIX.FB, HK.SL, US.SL, HF.SL.B, DIRECT
MIX.FB = fallback, HK.SM.B, US.SM.B, HK.SM.A, US.SM.A, HF.SL.B, JP.SL.A, TW.SL.A, SG.SL.A, KR.SL.A, CA.SL.A, GB.SL.A, FR.SL.A, GM.SL.A, TK.SL.A, OTHER.SL.A, hidden=true
FINAL.SL = select, HK.SL, US.SL, HF.SL.B, JP.SL.A, TW.SL.A, SG.SL.A, KR.SL.A, CA.SL.A, GB.SL.A, FR.SL.A, GM.SL.A, TK.SL.A, OTHER.SL.A, DIRECT
HK.SL = select, HK.SM.B, HK.SM.A
US.SL = select, US.SM.B, US.SM.A
NEWS.SL = select, DIRECT, US.SM.B
HK.SM.B = smart, include-other-group=B, policy-regex-filter=香港, url=http://www.gstatic.com/generate_204, no-alert=true
US.SM.B = smart, include-other-group=B, policy-regex-filter=美国, url=http://www.gstatic.com/generate_204, no-alert=true
HF.SL.B = select, include-other-group=B, policy-regex-filter=亚太, url=http://www.gstatic.com/generate_204, no-alert=true
HK.SM.A = smart, include-other-group="B, F", policy-regex-filter=香港, url=http://www.gstatic.com/generate_204, no-alert=true
US.SM.A = smart, include-other-group="B, F", policy-regex-filter=美国, url=http://www.gstatic.com/generate_204, no-alert=true
JP.SM.A = smart, include-other-group="B, F", policy-regex-filter=日本, url=http://www.gstatic.com/generate_204, no-alert=true, hidden=true
TW.SM.A = smart, include-other-group="B, F", policy-regex-filter=台湾, url=http://www.gstatic.com/generate_204, no-alert=true, hidden=true
SG.SM.A = smart, include-other-group="B, F", policy-regex-filter=新加坡, url=http://www.gstatic.com/generate_204, no-alert=true, hidden=true
KR.SM.A = smart, include-other-group="B, F", policy-regex-filter=韩国, url=http://www.gstatic.com/generate_204, no-alert=true, hidden=true
CA.SM.A = smart, include-other-group="B, F", policy-regex-filter=加拿大, url=http://www.gstatic.com/generate_204, no-alert=true, hidden=true
GB.SM.A = smart, include-other-group="B, F", policy-regex-filter=英国, url=http://www.gstatic.com/generate_204, no-alert=true, hidden=true
FR.SM.A = smart, include-other-group="B, F", policy-regex-filter=法国, url=http://www.gstatic.com/generate_204, no-alert=true, hidden=true
GM.SM.A = smart, include-other-group="B, F", policy-regex-filter=德国, url=http://www.gstatic.com/generate_204, no-alert=true, hidden=true
TK.SM.A= smart, include-other-group="B, F", policy-regex-filter=土耳其, url=http://www.gstatic.com/generate_204, no-alert=true, hidden=true
OTHER.SL.A = select, include-other-group="B, F", policy-regex-filter=摩尔多瓦|乌克兰|意大利|匈牙利|西班牙|荷兰|阿根廷|巴西|智利|澳大利亚|新西兰|印尼|泰国|越南|印度|巴基斯坦|以色列|阿联酋|菲律宾|马来西亚|埃及|尼日利亚, url=http://www.gstatic.com/generate_204, no-alert=true

[Rule]

[SSID Setting]
TYPE:WIRED tfo-behaviour=force-enabled, cellular-fallback=off
TYPE:WIFI tfo-behaviour=force-enabled, cellular-fallback=off
TYPE:CELLULAR tfo-behaviour=force-enabled, cellular-fallback=off #!IOS-ONLY
# ###############################################

[MITM]
enable = true #开启 HTTPS MITM 解密。
tcp-connection = false #不启用 TCP Connection 级别的 MITM 功能。
skip-server-cert-verify = false #是否跳过验证真实服务器证书
